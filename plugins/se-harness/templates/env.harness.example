# .env.harness — GITIGNORED (A5 #3). Copy to .env.harness and fill in.
# Everything secret lives here; everything shareable lives in .harness/profile.yaml.
#
# This repo-level file is for THIS repo's own secrets only. Org-wide credentials
# (Jira/Confluence/SharePoint/GitHub) are not here — they live in a workspace-root
# .env.harness instead (templates/env.harness.workspace.example), filled once, not
# once per repo. If this repo has no workspace (a plain single-repo project), /harness-init
# still only writes the fields below here — org-wide sources aren't part of this template
# regardless, since a single-repo project has no "workspace root" to put them in either;
# add them directly if you need them for a single repo (same var names as the workspace
# template).

# Cloud provider (only the one named in profile.yaml `cloud:` — genuinely per-repo,
# different repos can deploy to different accounts/subscriptions)
AWS_PROFILE=
AZURE_SUBSCRIPTION_ID=
GCP_PROJECT=
VERCEL_TOKEN=

# Observability keys (Langfuse), Copilot CLI path only: org-wide, so they normally live in the
# workspace-root .env.harness (templates/env.harness.workspace.example). A plain single-repo project has
# no workspace root - put LANGFUSE_PUBLIC_KEY / LANGFUSE_SECRET_KEY here instead. The Claude Code plugin
# does not read them (it uses the OS keychain).
