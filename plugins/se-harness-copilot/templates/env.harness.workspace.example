# .env.harness — WORKSPACE ROOT, GITIGNORED. Copy to .env.harness here (not in any repo) and
# fill in. These are org-wide credentials, shared by every unit in this workspace — filled once,
# not once per repo. Created and read by /harness-mem-wiki; repo-level .env.harness files
# (templates/env.harness.example) are for each repo's own secrets instead (cloud-provider creds
# chief among them), never these.

# Atlassian MCP (Jira stories, Confluence PRDs, XRay/Zephyr test cases)
ATLASSIAN_BASE_URL=
ATLASSIAN_EMAIL=
ATLASSIAN_API_TOKEN=

# GitHub MCP (PRs, used by /harness-goal's commit/PR auto-logging and by PR-sourced context
# if a future revision adds it — not currently read by /harness-mem-wiki itself)
GITHUB_PERSONAL_ACCESS_TOKEN=

# SharePoint MCP (tier-3 wiki ingestion) — se-harness doesn't ship a SharePoint MCP server;
# stand one up and register it in .mcp.json first (docs/setup-guide-copilot.md Part 6). These
# vars are read by whichever SharePoint MCP you point at, not by se-harness scripts directly.
SHAREPOINT_CLIENT_ID=
SHAREPOINT_CLIENT_SECRET=

# Langfuse (agent-session tracing) - only when observability.provider is langfuse. The endpoint
# itself is not secret: it lives in workspace.yaml shared.observability.host. Create the keys in
# the Langfuse UI (project settings -> API keys).
#   * Copilot CLI: read from here by scripts/langfuse-otel-env.sh, which exports the OpenTelemetry
#     variables (Copilot has no Langfuse plugin).
#   * Claude Code: NOT used - the langfuse-observability plugin keeps its own copy of the keys in the
#     OS keychain; enter them with /plugin configure langfuse-observability@langfuse-observability.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Sourcegraph MCP (only if memory.structural_driver is sourcegraph AND memory.sourcegraph.auth is token).
# An access token with the "mcp" scope. OAuth needs no variable. Never commit a value.
SOURCEGRAPH_ACCESS_TOKEN=
