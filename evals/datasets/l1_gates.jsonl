{"id": "gate/allows/docker-build-without-push", "kind": "hook", "script": "gate-check.sh", "suite": "gate", "req": [{"id": "REQ-001", "status": "draft"}], "command": "docker build -t app .", "expect_exit": 0}
{"id": "gate/allows/kubectl-get", "kind": "hook", "script": "gate-check.sh", "suite": "gate", "req": [{"id": "REQ-001", "status": "draft"}], "command": "kubectl get pods", "expect_exit": 0}
{"id": "gate/status/approvedx-is-not-approved", "kind": "hook", "script": "gate-check.sh", "suite": "gate", "req": [{"id": "REQ-001", "status": "approvedX"}], "command": "git push", "expect_exit": 2, "stderr_contains": "BLOCKED by se-harness gate"}
{"id": "gate/status/in-progress-with-incomplete-plan-still-blocks", "kind": "hook", "script": "gate-check.sh", "suite": "gate", "req": [{"id": "REQ-001", "status": "in-progress", "plan": {"rows": [["a", "pending"]], "integration": "pending"}}], "command": "git push", "expect_exit": 2}

{"id": "gate/vendored-alone/still-blocks-push-without-helper", "kind": "hook", "script": "gate-check.sh", "suite": "gate", "vendored_alone": true, "req": [{"id": "REQ-001", "status": "draft"}], "command": "git push origin main", "expect_exit": 2, "stderr_contains": "BLOCKED by se-harness gate"}
{"id": "gate/vendored-alone/still-allows-approved", "kind": "hook", "script": "gate-check.sh", "suite": "gate", "vendored_alone": true, "req": [{"id": "REQ-001", "status": "approved"}], "command": "git push origin main", "expect_exit": 0}
{"id": "gate/vendored-alone/ignores-other-commands", "kind": "hook", "script": "gate-check.sh", "suite": "gate", "vendored_alone": true, "req": [{"id": "REQ-001", "status": "draft"}], "command": "ls -la", "expect_exit": 0}
{"id": "contract/vendored-alone/still-flags-contract-change", "kind": "hook", "script": "contract-check.sh", "suite": "contract", "vendored_alone": true, "fixture": "demo-loan-app", "command": "git push origin main", "appends": {"contracts/loan-record.md": "\nx\n"}, "expect_exit": 2, "stderr_contains": "loan-record"}
